{
  "name": "reisotor-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO_MODE=true vite",
    "dev:landing": "VITE_BUILD_TARGET=landing vite --open landing.html",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build": "vue-tsc --noEmit && vite build",
    "build:landing": "VITE_BUILD_TARGET=landing VITE_BASE=/reisotor/ vite build --outDir dist-landing",
    "build:landing-dist": "VITE_BUILD_TARGET=landing vite build --outDir dist --emptyOutDir=false",
    "build:demo": "VITE_DEMO_MODE=true VITE_BASE=/reisotor/demo/ vite build --outDir dist-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry -o dist-storybook",
    "build-storybook": "storybook build --disable-telemetry",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@keeratita/heic-converter": "^0.5.2",
    "@tabler/icons": "^3.49.0",
    "@tabler/icons-vue": "^3.49.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "dompurify": "^3.4.13",
    "exifreader": "^4.45.1",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "piexifjs": "^1.0.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/vue3": "^8.6.18",
    "@storybook/vue3-vite": "^10.6.3",
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.12",
    "@types/piexifjs": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "jsdom": "^30.0.1",
    "rolldown-vite": "^7.3.1",
    "sharp": "^0.35.3",
    "storybook": "^8.6.18",
    "typescript": "^5.6.3",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.1.6",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
