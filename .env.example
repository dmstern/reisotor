# Kopieren nach .env und mit echten Werten fuellen. .env ist gitignored.

# SSH-Benutzername auf dem Zielserver
SSH_USER=

# Oeffentliche Domain des Servers, erreichbar ueber Portweiterleitung
PUBLIC_HOST=

# Optional: lokaler Hostname/IP des Servers im Heimnetz (z. B. <geraetename>.fritz.box),
# falls PUBLIC_HOST von dort aus nicht erreichbar ist (NAT-Hairpin) und es keine
# lokale Alternativroute gibt (z. B. per /etc/hosts-Eintrag). Wird zuerst probiert,
# bevor auf PUBLIC_HOST zurueckgefallen wird. Leer lassen, um den Check zu ueberspringen.
# LOCAL_HOST=

# Optional: OpenRouteService API-Key für echte Weg- & Straßen-Routen (Auto, Fahrrad, Fußweg)
# sowie automatische Fahrzeit- & Distanzberechnung in Touren und Etappen.
# Kostenlos erhältlich unter https://account.heigit.org (Standard-Token reicht aus).
# Bleibt dieser leer, ist die App voll funktionsfähig und fällt auf Luftlinie bzw. manuelle Eingabe zurück.
# ORS_API_KEY=

# Betreiberangaben für Impressum (§ 5 DDG) und Datenschutzerklärung (Art. 13 DSGVO).
# Verantwortlich ist der jeweilige Instanzbetreiber; fehlen die Pflichtangaben, zeigt die App einen Warnhinweis.
# LEGAL_OPERATOR_NAME=
# LEGAL_OPERATOR_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# LEGAL_CONTACT_PHONE=

# Optional: Weiterleitung von In-App-Feedback an den zentralen Relay-Dienst (Standard: aktiv)
# Setze auf "false", falls deine selbstgehostete Instanz keinerlei Feedback weiterleiten soll.
# FEEDBACK_RELAY_FORWARDING=true
# FEEDBACK_RELAY_URL=https://reise.ruebenherz.de/api/feedback/relay

# Optional: Betreibe diesen Server als Feedback-Relay für externe Instanzen (benötigt GITHUB_TOKEN)
# FEEDBACK_RELAY_ENABLED=false

# Optional: E-Mail-Versand (Passwort-Reset, E-Mail-Bestätigung / Double-Opt-In)
# Ohne SMTP bleibt Reisotor voll funktionsfähig; Admins können Passwörter direkt im UI zurücksetzen.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=deine-adresse@example.com
# SMTP_PASS=dein-passwort-oder-app-token
# SMTP_FROM="Reisotor" <noreply@example.com>
# APP_URL=https://reise.ruebenherz.de
# REQUIRE_EMAIL_VERIFICATION=true
