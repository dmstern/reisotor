# Kopieren nach .env und mit echten Werten fuellen. .env ist gitignored.

# SSH-Benutzername auf dem Zielserver (Pi)
SSH_USER=

# Lokaler Hostname/IP des Pi im Heimnetz (z. B. <geraetename>.fritz.box) –
# wird zuerst probiert, damit das Deployment auch ohne Portfreigabe funktioniert
LOCAL_HOST=

# Oeffentliche Domain des Pi, erreichbar ueber Portweiterleitung – Fallback,
# falls LOCAL_HOST nicht erreichbar ist (z. B. unterwegs)
PUBLIC_HOST=
