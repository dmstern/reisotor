.claude

# Persoenliche Werte fuers Deploy-Skript (Domain, SSH-User, lokaler Hostname).
# Vorlage: .env.example
.env

node_modules/

# e2e-Testsuite (siehe /e2e): Abhaengigkeiten, wegwerfbare Test-DB, Login-Session, Testartefakte
# und zur Laufzeit generierte Fixtures/Ad-hoc-Checks werden nie committet.
e2e/node_modules
e2e/.tmp
e2e/.auth
e2e/test-results
e2e/playwright-report
e2e/fixtures/seeded-data.json
e2e/tests/scratch/

# Lokal zusammengestelltes Release-Artefakt (Nachbau des "Assemble release artifact"-Schritts aus
# .github/workflows/ci.yml fuer einen manuellen Deploy, z. B. bei einer GitHub-Actions-
# Stoerung) - reiner Build-Output wie dist/, nie committen.
/release
