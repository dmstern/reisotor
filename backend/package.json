{
  "name": "reisotor-backend",
  "version": "1.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-build-info.mjs && tsx src/db/seed.ts && tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build": "tsc && node scripts/generate-build-info.mjs",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "seed:demo": "tsx src/db/seedDemo.ts",
    "seed:demo:force": "tsx src/db/seedDemo.ts --force",
    "db:clear": "tsx src/db/clear.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/session": "^10.9.0",
    "@fastify/static": "^7.0.4",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^4.28.1",
    "nodemailer": "10.2.1",
    "sanitize-html": "^2.17.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
