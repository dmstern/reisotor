# Supply-Chain-Schutz & Reproduzierbarkeit (Issue #548)
# 1. Exakte Versionen speichern statt Caret-Ranges (^), um unkontrolliertes Driften zu verhindern.
save-exact=true
# 2. Mindest-Reifezeit (in Tagen) für Paket-Releases (wird von modernen npm/pnpm-Versionen und
#    unserem scripts/security-check.mjs ausgewertet, um Zero-Day Supply-Chain-Angriffe abzuwehren).
min-release-age=7
# 3. Verhindert den Arborist-PeerSet-Crash (reading 'edgesOut') unter Node 22 bei npm audit fix.
legacy-peer-deps=true
# 4. Sicherheitsprüfung bei Installationen aktivieren.
audit=true
